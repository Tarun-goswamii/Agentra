# ─────────────────────────────────────────────
# AMD Developer Cloud — vLLM Endpoint
# ─────────────────────────────────────────────
# After starting vLLM on your AMD instance,
# set the public IP here:
AMD_BASE_URL=http://YOUR_AMD_INSTANCE_IP:8000/v1

# Model running on AMD GPU (must match what vLLM serves)
AMD_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# vLLM does not require a real API key — "EMPTY" is the convention
AMD_API_KEY=EMPTY

# ─────────────────────────────────────────────
# Fallback: Groq (for local dev without AMD)
# Get free key: https://console.groq.com
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ─────────────────────────────────────────────
# Backend selection: "amd" or "groq"
# ─────────────────────────────────────────────
LLM_BACKEND=amd
